# Voice Ops Agent – environment configuration
# Copy this file to .env and adjust values as needed.

# VAD energy threshold (RMS); raise to require louder speech detection
VAD_THRESHOLD=300

# Fixed transcript returned by mock STT (leave blank for random utterance)
STT_TRANSCRIPT=

# Simulated STT latency in seconds
STT_LATENCY=0.05

# Simulated LLM streaming latency between tokens (seconds)
LLM_TOKEN_LATENCY=0.02

# Simulated LLM time-to-first-token latency (seconds)
LLM_FIRST_LATENCY=0.05

# Fixed LLM response (leave blank for intent-matched canned reply)
LLM_RESPONSE=

# Simulated TTS first-chunk latency (seconds)
TTS_LATENCY=0.03
